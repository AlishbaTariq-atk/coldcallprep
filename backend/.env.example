# --- Model provider (used by agent/tools.py) ---
# Get a key at console.groq.com (separate from any Claude subscription).
GROQ_API_KEY=your-groq-api-key

# Optional. Overrides the default Groq model (llama-3.1-8b-instant) with
# no code change — set this in Railway's dashboard and restart the
# service to swap models (e.g. to llama-3.3-70b-versatile) without a
# git push/redeploy. Leave unset to use the default.
# GROQ_MODEL_NAME=llama-3.1-8b-instant

# --- Supabase (used by supabase_client.py to persist completed runs) ---
# Project Settings -> API in the Supabase dashboard. Use the service_role
# / "Secret key" — not the anon/publishable one — since this is a
# trusted server-side write with no user session.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
