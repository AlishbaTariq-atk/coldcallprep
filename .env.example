# --- Supabase ---
# Project Settings -> API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only: used by /backend to write prospects/briefs. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Model provider (used by the LangGraph / deepagents agent in /backend) ---
# Get a key at console.groq.com (separate from any Claude subscription).
GROQ_API_KEY=your-groq-api-key

# --- Backend service ---
# URL of the FastAPI agent service. Used by Next.js API routes to proxy
# /api/run and /api/run/[runId]/status. Local dev default shown.
BACKEND_URL=http://localhost:8000
